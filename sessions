#!/usr/bin/env bash
# sessions — friendly tmux session manager, local or over SSH
#
# Usage:
#   sessions                     interactive menu on default host
#   sessions <host>              interactive menu on <host>
#   sessions <host> ls           list sessions, non-interactive
#   sessions <host> new [name] [dir]  create a session (named or auto) with
#                                     optional starting directory, then attach
#   sessions <host> attach name  attach to an existing session
#   sessions <host> kill name    kill a session
#
# <host> of "localhost" (or the current hostname) runs tmux directly,
# no SSH. Default host: $SESSIONS_HOST, else localhost.
# Set a different default in your shell rc:  export SESSIONS_HOST=gateway0
#
# Colors are on when stdout is a TTY. Set NO_COLOR=1 to force plain output.

set -euo pipefail

DEFAULT_HOST="${SESSIONS_HOST:-localhost}"

# ---- arg parsing ----------------------------------------------------------
# First positional may be a host OR a subcommand. If it's a subcommand, host
# defaults. Subcommands: ls, new, attach, kill.
SUBCMDS="ls new attach kill"

if [[ $# -eq 0 ]]; then
  HOST="$DEFAULT_HOST"; CMD="menu"; set --
elif [[ " $SUBCMDS " == *" $1 "* ]]; then
  HOST="$DEFAULT_HOST"; CMD="$1"; shift
else
  HOST="$1"; shift
  if [[ $# -eq 0 ]]; then CMD="menu"; else CMD="$1"; shift; fi
fi

is_local() {
  [[ "$1" == "localhost" || "$1" == "127.0.0.1" || "$1" == "$(hostname)" || "$1" == "$(hostname -s)" ]]
}

# run_tmux [--tty] <host> <tmux-args...>
# Runs tmux locally if host is this machine, otherwise ssh's. --tty allocates
# a controlling tty (needed for attach/new).
run_tmux() {
  local tty=""
  [[ "$1" == "--tty" ]] && { tty="t"; shift; }
  local host="$1"; shift
  if is_local "$host"; then
    tmux "$@"
  elif [[ -n "$tty" ]]; then
    ssh -t "$host" tmux "$@"
  else
    ssh "$host" tmux "$@"
  fi
}

# ---- colors ---------------------------------------------------------------
# ANSI escapes, blanked when stdout isn't a TTY or NO_COLOR is set. Using
# $'\e[...m' literals so there's no runtime subshell per draw.
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_RESET=$'\e[0m'
  C_BOLD=$'\e[1m'
  C_DIM=$'\e[2m'
  C_RED=$'\e[31m'
  C_GREEN=$'\e[32m'
  C_YELLOW=$'\e[33m'
  C_BLUE=$'\e[34m'
  C_CYAN=$'\e[36m'
  C_GRAY=$'\e[90m'
else
  C_RESET=""; C_BOLD=""; C_DIM=""
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_CYAN=""; C_GRAY=""
fi

# ---- helpers --------------------------------------------------------------
human_ago() {
  # unix-ts -> "5m ago", "2h ago", "3d ago", "never" for 0
  local ts="$1" now diff
  [[ "$ts" == "0" || -z "$ts" ]] && { printf "never"; return; }
  now=$(date +%s)
  diff=$(( now - ts ))
  if   (( diff < 60   )); then printf "just now"
  elif (( diff < 3600 )); then printf "%dm ago" $(( diff / 60 ))
  elif (( diff < 86400 )); then printf "%dh ago" $(( diff / 3600 ))
  else                         printf "%dd ago" $(( diff / 86400 ))
  fi
}

# Repeat a single character N times.
repeat_char() {
  local char="$1" n="$2" out=""
  while (( n > 0 )); do out+="$char"; (( n-- )); done
  printf '%s' "$out"
}

# Returns rows: name|created|last_attached|attached
fetch_sessions() {
  local host="${1:-$HOST}"
  run_tmux "$host" ls -F '#{session_name}|#{session_created}|#{session_last_attached}|#{session_attached}' 2>/dev/null || true
}

# Print numbered table. Sets global SESSION_NAMES array with names by index.
# Returns 0 if any sessions were listed, 1 if none.
SESSION_NAMES=()
list_sessions() {
  local rows
  rows=$(fetch_sessions)
  SESSION_NAMES=()

  # Header banner, same for both empty and populated cases.
  printf '\n  %s%sSessions on %s%s%s\n\n' \
    "$C_BOLD" "$C_CYAN" "$HOST" "$C_RESET" ""

  if [[ -z "$rows" ]]; then
    printf '  %s(no sessions)%s\n' "$C_DIM" "$C_RESET"
    return 1
  fi

  # Pass 1: parse rows into parallel arrays and compute column widths.
  # The "● " / "○ " glyph is one display column but up to three bytes;
  # ${#str} in a UTF-8 locale counts characters, which is what we want.
  local -a names=() starteds=() lasts=() states=() state_colors=()
  local w_num=1 w_name=4 w_started=7 w_last=9 w_state=10
  local i=1 name created last_att attached started_h last_h state state_color
  while IFS='|' read -r name created last_att attached; do
    [[ -z "$name" ]] && continue
    SESSION_NAMES[i]="$name"
    started_h=$(human_ago "$created")
    last_h=$(human_ago "$last_att")
    if [[ "$attached" == "1" ]]; then
      state="● attached"
      state_color="$C_GREEN"
    else
      state="○ detached"
      state_color="$C_DIM"
    fi
    names[i]="$name"
    starteds[i]="$started_h"
    lasts[i]="$last_h"
    states[i]="$state"
    state_colors[i]="$state_color"
    (( ${#i}         > w_num     )) && w_num=${#i}
    (( ${#name}      > w_name    )) && w_name=${#name}
    (( ${#started_h} > w_started )) && w_started=${#started_h}
    (( ${#last_h}    > w_last    )) && w_last=${#last_h}
    (( ${#state}     > w_state   )) && w_state=${#state}
    (( i++ )) || true
  done <<< "$rows"
  local n=$(( i - 1 ))

  # Column headers (dim, uppercase).
  printf '  %s%*s   %-*s   %-*s   %-*s   %-*s%s\n' \
    "$C_DIM" \
    "$w_num" "#" \
    "$w_name" "NAME" \
    "$w_started" "STARTED" \
    "$w_last" "LAST USED" \
    "$w_state" "STATE" \
    "$C_RESET"

  # Separator — one '─' per character under each column, joined by spaces
  # matching the header's inter-column spacing (three spaces = three dashes
  # rendered as '─' so the line reads as continuous).
  local sep="$(repeat_char '─' "$w_num")───$(repeat_char '─' "$w_name")───$(repeat_char '─' "$w_started")───$(repeat_char '─' "$w_last")───$(repeat_char '─' "$w_state")"
  printf '  %s%s%s\n' "$C_GRAY" "$sep" "$C_RESET"

  # Data rows.
  local k
  for k in $(seq 1 "$n"); do
    printf '  %s%*s%s   %s%-*s%s   %s%-*s%s   %s%-*s%s   %s%-*s%s\n' \
      "$C_CYAN"  "$w_num"     "$k"             "$C_RESET" \
      "$C_BOLD"  "$w_name"    "${names[k]}"    "$C_RESET" \
      "$C_DIM"   "$w_started" "${starteds[k]}" "$C_RESET" \
      "$C_DIM"   "$w_last"    "${lasts[k]}"    "$C_RESET" \
      "${state_colors[k]}" "$w_state" "${states[k]}" "$C_RESET"
  done
  return 0
}

# Interactive prompt for host + name + working dir, then create.
prompt_new_session() {
  local nh nm nd
  read -r -p "$(printf '  %shost%s [%s]: ' "$C_CYAN" "$C_RESET" "$HOST")" nh
  nh="${nh:-$HOST}"
  read -r -p "$(printf '  %sname%s (blank = auto): ' "$C_CYAN" "$C_RESET")" nm
  # -e enables readline for editing + Tab completion. `set -o emacs` is
  # required because in a non-interactive shell line editing is off, and
  # `bind` silently has no effect until it's on. After that, the three
  # binds configure TAB for filename completion against the LOCAL
  # filesystem — type absolute paths for remote hosts whose layout
  # doesn't mirror local.
  set -o emacs
  bind 'TAB:complete' 2>/dev/null || true
  bind 'set show-all-if-ambiguous on' 2>/dev/null || true
  bind 'set completion-ignore-case on' 2>/dev/null || true
  read -r -e -p "$(printf '  %sdir%s  (blank = home): ' "$C_CYAN" "$C_RESET")" nd
  # Expand a leading '~' to $HOME (bash's `read` leaves it literal).
  [[ -n "$nd" ]] && nd="${nd/#\~/$HOME}"
  new_session "$nm" "$nh" "$nd"
}

attach_by_name() {
  local name="$1" host="${2:-$HOST}"
  printf '  %s→%s Connecting to %s%s%s on %s%s%s...\n' \
    "$C_CYAN" "$C_RESET" \
    "$C_BOLD" "$name" "$C_RESET" \
    "$C_BOLD" "$host" "$C_RESET"
  run_tmux --tty "$host" attach -t "$name"
}

new_session() {
  local name="${1:-}" host="${2:-$HOST}" dir="${3:-}"
  if [[ -z "$name" ]]; then
    name="work-$(date +%Y%m%d-%H%M%S)"
  fi
  if [[ -n "$dir" ]]; then
    printf '  %s+%s Starting %s%s%s on %s%s%s (cwd: %s%s%s)...\n' \
      "$C_GREEN" "$C_RESET" \
      "$C_BOLD" "$name" "$C_RESET" \
      "$C_BOLD" "$host" "$C_RESET" \
      "$C_DIM"  "$dir"  "$C_RESET"
    run_tmux --tty "$host" new -A -s "$name" -c "$dir"
  else
    printf '  %s+%s Starting %s%s%s on %s%s%s...\n' \
      "$C_GREEN" "$C_RESET" \
      "$C_BOLD" "$name" "$C_RESET" \
      "$C_BOLD" "$host" "$C_RESET"
    run_tmux --tty "$host" new -A -s "$name"
  fi
}

kill_by_name() {
  local name="$1" host="${2:-$HOST}"
  if run_tmux "$host" kill-session -t "$name"; then
    printf '  %s✕%s Killed %s%s%s on %s%s%s.\n' \
      "$C_RED" "$C_RESET" \
      "$C_BOLD" "$name" "$C_RESET" \
      "$C_BOLD" "$host" "$C_RESET"
  fi
}

# ---- menu mode ------------------------------------------------------------
# One compact hint line, colored, with bullets separating actions. Written
# out rather than looped so the spacing stays even.
menu_hint() {
  local last="$1"
  printf '  %sConnect%s %s1-%s%s  %s•%s  %s(n)ew%s  %s•%s  %s(d #)%s kill  %s•%s  %s(q)%s quit\n' \
    "$C_DIM"  "$C_RESET" \
    "$C_CYAN" "$last" "$C_RESET" \
    "$C_GRAY" "$C_RESET" \
    "$C_CYAN" "$C_RESET" \
    "$C_GRAY" "$C_RESET" \
    "$C_CYAN" "$C_RESET" \
    "$C_GRAY" "$C_RESET" \
    "$C_CYAN" "$C_RESET"
}

menu_loop() {
  while true; do
    local has_sessions=0
    if list_sessions; then
      has_sessions=1
    fi
    echo

    if [[ $has_sessions -eq 0 ]]; then
      # No sessions exist — the only offer is to create one.
      read -r -p "$(printf '  %sCreate a new session?%s [Y/n] ' "$C_BOLD" "$C_RESET")" yn
      case "$yn" in
        n|N|no|No) exit 0 ;;
        *)         prompt_new_session; continue ;;
      esac
    fi

    # SESSION_NAMES is 1-indexed and tightly packed (no gaps), so its length
    # equals the highest valid index.
    local last=${#SESSION_NAMES[@]}
    menu_hint "$last"
    read -r -p "$(printf '  %s❯%s ' "$C_CYAN$C_BOLD" "$C_RESET")" input || { echo; exit 0; }
    case "$input" in
      q|quit|exit) exit 0 ;;
      ""|n|N|new) prompt_new_session ;;
      n\ *|new\ *)
        # shortcut form:  n [name] [@host]
        local rest="${input#* }" nm="" nh="$HOST"
        for tok in $rest; do
          if [[ "$tok" == @* ]]; then nh="${tok#@}"; else nm="$tok"; fi
        done
        new_session "$nm" "$nh"
        ;;
      d\ *|kill\ *)
        local num="${input#* }"
        if [[ "$num" =~ ^[0-9]+$ ]] && [[ -n "${SESSION_NAMES[num]:-}" ]]; then
          read -r -p "$(printf '  %s✕%s kill %s%s%s? [y/N] ' "$C_RED" "$C_RESET" "$C_BOLD" "${SESSION_NAMES[num]}" "$C_RESET")" yn
          [[ "$yn" =~ ^[Yy]$ ]] && kill_by_name "${SESSION_NAMES[num]}"
        else
          printf '  %sno such session number: %s%s\n' "$C_RED" "$num" "$C_RESET"
        fi
        ;;
      *)
        if [[ "$input" =~ ^[0-9]+$ ]] && [[ -n "${SESSION_NAMES[input]:-}" ]]; then
          attach_by_name "${SESSION_NAMES[input]}"
          # After detach, loop again
        else
          printf '  %sunrecognized: %s%s\n' "$C_RED" "$input" "$C_RESET"
        fi
        ;;
    esac
  done
}

# ---- dispatch -------------------------------------------------------------
case "$CMD" in
  menu)    menu_loop ;;
  ls)      list_sessions || true ;;
  new)     new_session "${1:-}" "$HOST" "${2:-}" ;;
  attach)  [[ $# -ge 1 ]] || { echo "usage: sessions $HOST attach <name>" >&2; exit 2; }
           attach_by_name "$1" ;;
  kill)    [[ $# -ge 1 ]] || { echo "usage: sessions $HOST kill <name>" >&2; exit 2; }
           kill_by_name "$1" ;;
  *)       echo "unknown subcommand: $CMD" >&2; exit 2 ;;
esac
